{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "compileone/token-stream/1.0",
  "title": "CompileOne lexical analysis artifact",
  "description": "Token stream emitted by the compileone lex phase (flex scanner for mini-c).",
  "type": "object",
  "required": ["schema", "phase", "language", "source_file", "generated_by", "duration_ms", "tokens", "statistics", "errors"],
  "properties": {
    "schema": { "const": "compileone/token-stream/1.0" },
    "phase": { "const": "lexical" },
    "language": { "type": "string" },
    "source_file": { "type": "string" },
    "generated_by": { "type": "string" },
    "duration_ms": { "type": "number" },
    "tokens": {
      "type": "array",
      "items": { "$ref": "#/definitions/token" }
    },
    "statistics": {
      "type": "object",
      "required": ["total", "by_category"],
      "properties": {
        "total": { "type": "integer" },
        "by_category": { "type": "object" }
      }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/definitions/lex_error" }
    }
  },
  "definitions": {
    "token": {
      "type": "object",
      "required": ["id", "line", "column", "lexeme", "token", "category", "offset"],
      "properties": {
        "id": { "type": "integer" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "lexeme": { "type": "string" },
        "token": { "type": "string" },
        "category": { "type": "string" },
        "offset": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer" },
            "end": { "type": "integer" }
          }
        }
      }
    },
    "lex_error": {
      "type": "object",
      "required": ["line", "column", "lexeme", "message"],
      "properties": {
        "line": { "type": "integer" },
        "column": { "type": "integer" },
        "lexeme": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
